{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "wwngo_app (live API)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=https://wwngo.com/backend",
        "--dart-define=WEBSITE_URL=https://wwngo.com",
        "--dart-define-from-file=dart_defines.json"
      ]
    },
    {
      "name": "wwngo_app (local API)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://192.168.1.5:3000",
        "--dart-define=WEBSITE_URL=https://wwngo.com",
        "--dart-define-from-file=dart_defines.json"
      ]
    }
  ]
}
