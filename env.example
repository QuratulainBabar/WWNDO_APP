# Backend / local dev secrets — copy to `env` (gitignored). Never commit `env`.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_RESET_SECRET=change-me-reset-secret-min-32-chars

JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=15m

OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6
OTP_MAX_SENDS=3
OTP_SEND_WINDOW_MINUTES=15

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM='WWNGO <noreply@example.com>'
SMTP_TLS_REJECT_UNAUTHORIZED=true

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

CORS_ORIGINS=*

APP_PUBLIC_URL=https://example.com

SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=id-and-liveness
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_TOKEN_TTL_SECS=600
SUMSUB_WEBHOOK_SECRET=

GOOGLE_MAPS_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

FCM_SERVICE_ACCOUNT_PATH=./serviceAccount.json
KYC_DEV_BYPASS=false